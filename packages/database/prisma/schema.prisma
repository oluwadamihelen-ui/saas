enum NotificationType {
  GENERATION_COMPLETE
  GENERATION_FAILED
  MOVIE_READY
  EPISODE_READY
  EXPORT_COMPLETE
  SUBSCRIPTION_EVENT
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// COIN ECONOMY / CREATOR MONETIZATION
//
// Viewers spend Cinerra Coins to unlock paid movies/episodes/scenes;
// settled spend splits between the publisher and the platform per
// PlatformSettings.publisherRevenueShareBps (a runtime-configurable
// percentage in basis points — 5000 = 50.00% — never hard-coded, per the
// spec). WalletTransaction is the immutable ledger and the only source of
// truth for a balance; Wallet.balance is a cached read of it, always
// written in the same DB transaction as the ledger row that changes it.
// Settled financial rows are never edited or deleted — a correction is
// always a new REVERSAL/REFUND row referencing the original.
// ---------------------------------------------------------------------------

enum ContentMonetizationScope {
  MOVIE
  EPISODE
  SCENE
}

enum MonetizationMode {
  FREE
  PAID
}

enum WalletTransactionType {
  COIN_PURCHASE
  CONTENT_UNLOCK
  CREATOR_REVENUE
  PLATFORM_REVENUE
  REFUND
  REVERSAL
  PAYOUT
  ADJUSTMENT
  PROMOTIONAL_CREDIT
  GENERATION_SPEND
  GENERATION_REFUND
}

enum CoinPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum CreatorEarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
  DISPUTED
}

enum ContentUnlockType {
  MOVIE_UNLOCK
  EPISODE_UNLOCK
  SCENE_UNLOCK
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ViewingEventType {
  STARTED
  QUARTER
  HALF
  THREE_QUARTER
  COMPLETED
}

// Every user has at most one Coin wallet, created lazily on first need
// (a viewer buying coins, or a creator earning their first payout).
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  type           WalletTransactionType
  amount         Int // signed: positive credits the wallet, negative debits it
  balanceAfter   Int // Wallet.balance snapshot right after this row, for audit
  referenceType  String? // e.g. "CoinPurchase", "ContentEntitlement", "Refund"
  referenceId    String?
  reversesId     String?
  reverses       WalletTransaction?  @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy     WalletTransaction[] @relation("Reversal")
  // Deterministic per logical operation (e.g. "unlock:<userId>:<scope>:<contentId>")
  // so a concurrent or retried request collides on this DB-level unique
  // constraint instead of creating a second charge — the actual
  // concurrency safety net, not just a nice-to-have.
  idempotencyKey String?               @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

// A batch of admin-granted promotional coins with a real expiration date.
// remainingCoins is tracked separately from Wallet.balance specifically so
// expiration can be enforced — coins are fungible once merged into the
// wallet balance, so without this per-grant ledger there would be no way
// to tell which coins in a balance are "promotional and expiring" versus
// purchased. consumePromotionalCoins() decrements remainingCoins (soonest-
// expiring grant first) as a bookkeeping side-effect alongside every real
// CONTENT_UNLOCK debit — it never gates or redirects the actual spend,
// which always debits Wallet.balance the normal way.
// userId is Cascade (not SetNull like RevenueTransaction) deliberately —
// this is a single-party record tied to one user's own wallet, which
// already cascades away with them; it isn't a settled transaction between
// two parties that must survive either side's account deletion.
// grantedByAdminId is a plain id, not a relation, so the admin who granted
// it can later delete their own account without touching this row.
model PromotionalGrant {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coins             Int // original grant amount
  remainingCoins    Int // decremented via FIFO consumption as the user spends
  reason            String?
  grantedByAdminId  String?
  expiresAt         DateTime
  expiredAt         DateTime? // set once the expiration job has processed it
  createdAt         DateTime  @default(now())

  @@index([userId, expiresAt])
}

// Admin-configurable purchasable coin bundles (spec §4) — never hard-coded
// prices in application code.
model CoinPackage {
  id         String   @id @default(cuid())
  coins      Int
  bonusCoins Int      @default(0)
  priceCents Int
  currency   String   @default("usd")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchases CoinPurchase[]
}

model CoinPurchase {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinPackageId String
  coinPackage   CoinPackage        @relation(fields: [coinPackageId], references: [id])
  // Snapshot at purchase time — a later admin edit to the package must
  // never change what an already-completed purchase is worth.
  coinsCredited Int
  amountCents   Int
  currency      String
  status        CoinPurchaseStatus @default(PENDING)
  provider      PaymentProvider
  // Generated by us (not the provider) at checkout time and passed as the
  // `reference` on the provider's own initialize-charge call — both
  // Paystack and Korapay echo it back verbatim on every webhook for that
  // charge, unlike Stripe's session id which only the provider assigns.
  // Doubles as this purchase's idempotency key: the webhook handler looks
  // purchases up by it, so a replayed event can never credit coins twice.
  providerReference   String    @unique
  providerTransactionId String?
  completedAt   DateTime?
  refundedAt    DateTime?
  createdAt     DateTime           @default(now())

  refund      Refund?
  chargebacks Chargeback[]

  @@index([userId])
}

model ContentEntitlement {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope      ContentMonetizationScope
  projectId  String
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId  String?
  episode    Episode?                 @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  sceneId    String?
  scene      Scene?                   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  unlockedAt DateTime                 @default(now())
  // Set instead of deleting the row when a settled unlock is reversed
  // (spec §28-29) — deleting it would cascade away the permanent
  // RevenueTransaction/CreatorEarning it's linked to, which must survive
  // regardless of what happens to access. Never deleted by application
  // code; see reverseContentUnlock in apps/web/src/lib/monetization.ts.
  revokedAt  DateTime?

  revenueTransaction RevenueTransaction?

  // Defense in depth against a duplicate row — NOT the primary guard
  // against a double charge (Postgres treats NULLs as distinct, so two
  // MOVIE-scope rows for the same project would both have
  // episodeId=sceneId=null and slip past this). The real guard is
  // WalletTransaction.idempotencyKey inside the same DB transaction —
  // see unlockContent in apps/web/src/lib/monetization.ts.
  @@unique([userId, projectId, episodeId, sceneId])
  @@index([userId])
  @@index([projectId])
}

// A settled financial record — must survive regardless of what happens
// later to the accounts or content it references (spec: "never delete
// settled financial transactions"). Every relation here is optional with
// onDelete: SetNull rather than Cascade, deliberately: either the
// publisher or the viewer deleting their own account, or the publisher
// deleting the project itself, must never destroy the other party's
// financial history. `projectTitle`/`episodeTitle` are snapshotted at
// creation time (same pattern as OrganizationInvite.invitedByName) so
// the transaction history stays legible even after a nulled FK — a real
// record should show what the content WAS called at the time of the
// sale, not rely on a live join that may return nothing.
model RevenueTransaction {
  id                  String              @id @default(cuid())
  publisherId         String?
  publisher           User?               @relation("PublisherRevenue", fields: [publisherId], references: [id], onDelete: SetNull)
  viewerId            String?
  viewer              User?               @relation("ViewerRevenue", fields: [viewerId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTitle        String
  episodeId           String?
  episode             Episode?            @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  episodeTitle        String?
  sceneId             String?
  scene               Scene?              @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  entitlementId       String?             @unique
  entitlement         ContentEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  // Plain id reference (not a relation) to the viewer's CONTENT_UNLOCK
  // WalletTransaction — deliberately not a foreign key, so a reversal can
  // always find the original ledger row to reverse even after entitlementId
  // above has been nulled out by the entitlement's own deletion.
  viewerUnlockTransactionId String
  unlockType          ContentUnlockType
  coinAmount          Int // gross coins spent by the viewer
  publisherShareCoins Int
  platformShareCoins  Int
  createdAt           DateTime            @default(now())

  earning CreatorEarning?
  refund  Refund?

  @@index([publisherId, createdAt])
  @@index([projectId])
}

model CreatorEarning {
  id                   String               @id @default(cuid())
  // Optional/SetNull for the same reason as RevenueTransaction above — a
  // publisher deleting their account must not erase the earning record
  // itself, only its own link back to the (now-gone) publisher account.
  publisherId          String?
  publisher            User?                @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  revenueTransactionId String               @unique
  revenueTransaction   RevenueTransaction   @relation(fields: [revenueTransactionId], references: [id], onDelete: Cascade)
  coins                Int // the publisher's share, in coins
  status               CreatorEarningStatus @default(PENDING)
  // When the settlement hold (PlatformSettings.settlementPeriodDays) clears.
  availableAt          DateTime
  paidAt               DateTime?
  payoutId             String?
  payout               Payout?              @relation(fields: [payoutId], references: [id])
  createdAt            DateTime             @default(now())

  @@index([publisherId, status])
}

// A creator's payout destination — one per user, provider's choice
// (Paystack or Korapay). accountName is always resolved from the
// provider's own account-verification API at connect time, never trusted
// from the form the creator typed into, so a payout can't be silently
// misdirected by a typo'd account number that happens to be valid but
// belongs to someone else.
model PayoutAccount {
  id     String          @id @default(cuid())
  userId String          @unique
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  bankCode      String
  accountNumber String
  accountName   String
  // Paystack requires a pre-created Transfer Recipient before any transfer
  // can be initiated; Korapay takes bank details directly on each disburse
  // call, so this stays null for Korapay accounts.
  paystackRecipientCode String?
  onboardingComplete    Boolean  @default(true)
  payoutsEnabled        Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Payout {
  id          String       @id @default(cuid())
  publisherId String
  publisher   User         @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  coins       Int
  amountCents Int // fiat conversion at payout time — see PlatformSettings.payoutCoinValueCents
  currency    String       @default("usd")
  status      PayoutStatus @default(PENDING)
  provider    PaymentProvider
  // Generated by us at claim time (before any network call) — doubles as
  // this payout's idempotency key/reference on the provider's own transfer
  // API, same pattern as CoinPurchase.providerReference.
  providerReference  String    @unique
  providerTransferId String?
  failureReason       String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  earnings CreatorEarning[]
}

model Refund {
  id     String @id @default(cuid())
  // Targets exactly one of: a fiat coin purchase refunded before the
  // coins were spent, or a settled content-unlock transaction reversed
  // per policy after the viewer already has access.
  coinPurchaseId       String?             @unique
  coinPurchase         CoinPurchase?       @relation(fields: [coinPurchaseId], references: [id])
  revenueTransactionId String?             @unique
  revenueTransaction   RevenueTransaction? @relation(fields: [revenueTransactionId], references: [id])
  coinsReversed        Int
  reason               String?
  status               RefundStatus        @default(PENDING)
  createdAt            DateTime            @default(now())
  completedAt          DateTime?
}

model Chargeback {
  id              String       @id @default(cuid())
  coinPurchaseId  String
  coinPurchase    CoinPurchase @relation(fields: [coinPurchaseId], references: [id], onDelete: Cascade)
  providerDisputeId String     @unique
  status          String       @default("OPEN") // OPEN | WON | LOST
  amountCents     Int
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([coinPurchaseId])
}

// Meaningful viewing milestones (spec §32-33) — never every page refresh.
// Scaffolded now; not yet wired into the player, which is a separate
// follow-up (the monetization event that matters is the paid unlock
// itself, which this model deliberately does not gate).
model ViewingEvent {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type      ViewingEventType
  createdAt DateTime         @default(now())

  @@index([projectId, createdAt])
  @@index([episodeId, createdAt])
}

// Single-row runtime configuration for the coin economy — admin-editable,
// never hard-coded or requiring a redeploy to change (spec §43). Revenue
// split rounding: publisherShare = floor(coinAmount * publisherRevenueShareBps / 10000),
// platformShare = coinAmount - publisherShare — the platform absorbs the
// remainder, guaranteeing viewer debit always exactly equals
// publisherShare + platformShare with no leakage. Documented once here
// rather than scattered across call sites.
model PlatformSettings {
  id                       String   @id @default("singleton")
  publisherRevenueShareBps Int      @default(5000) // 5000 = 50.00%
  settlementPeriodDays     Int      @default(7)
  payoutMinimumCoins       Int      @default(1000)
  // Coin-to-fiat conversion rate for creator payouts — nothing in the
  // schema defined this before payouts were built; it's deliberately
  // separate from CoinPackage's fiat price (what a viewer pays to buy a
  // coin), since a platform is never obligated to pay out at the same rate
  // it sells at.
  payoutCoinValueCents     Int      @default(1)
  payoutCurrency           String   @default("NGN")
  minMovieCoinPrice        Int      @default(50)
  maxMovieCoinPrice        Int      @default(500)
  minEpisodeCoinPrice      Int      @default(5)
  maxEpisodeCoinPrice      Int      @default(100)
  minSceneCoinPrice        Int      @default(1)
  maxSceneCoinPrice        Int      @default(25)
  // What generation itself costs the *creator* in Doe — this is what
  // actually recovers real provider spend, separate from the
  // viewer-facing unlock prices above. Doe, not cents, so it moves with
  // the rest of the in-app economy; see README for how these map back to
  // real per-unit provider pricing and the assumptions behind them.
  doeCostPerReferenceImage Int      @default(10)
  doeCostPerVideoSecond    Int      @default(7)
  // Text generation (story/screenplay/character/location/prop bibles): one
  // flat charge per generation call, same simplification as the reference
  // image cost above — prompt/output size varies, but not enough to justify
  // per-token billing at this stage.
  doeCostPerTextGeneration Int      @default(8)
  // Dialogue voice synthesis, per 100 characters of spoken text.
  doeCostPerVoice100Chars  Int      @default(2)
  // Sound effect and music generation share this rate — both are billed
  // per second of generated audio and cost the platform a similar order of
  // magnitude per provider-second.
  doeCostPerAudioSecond    Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
