// Prisma schema for the AI animated video SaaS.
// Run `npx prisma migrate dev` after editing to create/apply a migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Public site
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth compatible models)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole  @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  subscription   Subscription?
  creditBalance  CreditBalance?
  creditLedger   CreditLedgerEntry[]

  projects   Project[]
  characters Character[]
  assets     Asset[]
  voices     VoicePreset[]
  musicTracks MusicTrack[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Billing / Credits
// ---------------------------------------------------------------------------

enum PlanId {
  FREE
  STARTER
  CREATOR
  PRO
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 PlanId             @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

enum CreditReason {
  SIGNUP_GRANT
  MONTHLY_GRANT
  PURCHASE
  SCRIPT_GENERATION
  STORYBOARD_GENERATION
  IMAGE_GENERATION
  VIDEO_GENERATION
  VOICE_GENERATION
  MUSIC_GENERATION
  RENDER
  REFUND
  ADMIN_ADJUSTMENT
}

model CreditLedgerEntry {
  id        String       @id @default(cuid())
  userId    String
  amount    Int // positive = credit, negative = debit
  reason    CreditReason
  balanceAfter Int
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger_entries")
}

// ---------------------------------------------------------------------------
// Projects / Scenes / Characters
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  SCRIPT_READY
  STORYBOARD_READY
  GENERATING
  READY_TO_EDIT
  RENDERING
  COMPLETED
  FAILED
}

enum AspectRatio {
  RATIO_16_9
  RATIO_9_16
  RATIO_1_1
}

enum VisualStyle {
  MODERN_CARTOON
  STORYBOOK
  COMIC
  THREE_D_ANIMATION
  MINIMAL_ILLUSTRATION
  HAND_DRAWN
  CINEMATIC_CARTOON
  EDUCATIONAL
  KIDS_ANIMATION
  DOCUMENTARY_ILLUSTRATION
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?       @db.Text
  idea        String?       @db.Text
  script      String?       @db.Text
  status      ProjectStatus @default(DRAFT)

  language    String      @default("en")
  audience    String?
  targetLengthSeconds Int?
  aspectRatio AspectRatio @default(RATIO_16_9)

  visualStyle   VisualStyle @default(MODERN_CARTOON)
  mood          String?
  colorMood     String?
  cameraMovement String?
  animationIntensity String?

  thumbnailUrl String?
  finalVideoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes     Scene[]
  characters ProjectCharacter[]
  assets     Asset[]
  jobs       GenerationJob[]
  renders    RenderJob[]
  music      ProjectMusic[]

  @@index([userId])
  @@map("projects")
}

enum SceneStatus {
  DRAFT
  GENERATING
  IMAGE_READY
  ANIMATION_READY
  VOICE_READY
  READY
  FAILED
}

model Scene {
  id        String      @id @default(cuid())
  projectId String
  order     Int
  title     String
  narration String?     @db.Text
  visualPrompt String?  @db.Text
  location  String?
  camera    String?
  transition String?    @default("fade")
  durationSeconds Int   @default(6)
  status    SceneStatus @default(DRAFT)

  imageUrl  String?
  videoUrl  String?
  voiceUrl  String?
  voiceDurationSeconds Float?

  imageStatus     JobStageStatus @default(PENDING)
  animationStatus JobStageStatus @default(PENDING)
  voiceStatus     JobStageStatus @default(PENDING)

  voicePresetId String?
  voiceSpeed    Float?  @default(1.0)
  voicePitch    Float?  @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characters SceneCharacter[]
  captions   Caption[]
  voicePreset VoicePreset?    @relation(fields: [voicePresetId], references: [id])
  jobs       GenerationJob[]

  @@index([projectId, order])
  @@map("scenes")
}

enum JobStageStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Caption {
  id         String   @id @default(cuid())
  sceneId    String
  text       String
  startMs    Int
  endMs      Int
  order      Int

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, order])
  @@map("captions")
}

model Character {
  id          String   @id @default(cuid())
  userId      String
  name        String
  ageCategory String?
  genderPresentation String?
  appearance  String?  @db.Text
  hair        String?
  clothing    String?
  accessories String?
  personality String?  @db.Text
  visualDescriptor String? @db.Text // canonical prompt fragment used for consistency
  referenceImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectCharacter[]
  scenes   SceneCharacter[]

  @@index([userId])
  @@map("characters")
}

model ProjectCharacter {
  id          String @id @default(cuid())
  projectId   String
  characterId String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  @@map("project_characters")
}

model SceneCharacter {
  id          String @id @default(cuid())
  sceneId     String
  characterId String

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

// ---------------------------------------------------------------------------
// Assets / Voices / Music
// ---------------------------------------------------------------------------

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  REFERENCE_IMAGE
  UPLOAD
}

model Asset {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  type      AssetType
  url       String
  storageKey String
  mimeType  String?
  sizeBytes Int?
  metadata  Json?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("assets")
}

enum VoiceStyle {
  WARM
  ENERGETIC
  DRAMATIC
  PROFESSIONAL
  EDUCATIONAL
  FRIENDLY
  STORYTELLING
}

model VoicePreset {
  id       String     @id @default(cuid())
  userId   String?
  name     String
  provider String     @default("mock")
  providerVoiceId String?
  language String     @default("en")
  accent   String?
  style    VoiceStyle @default(FRIENDLY)
  gender   String?
  isSystem Boolean    @default(true) // built-in library voice vs user-cloned voice
  previewUrl String?

  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes Scene[]

  @@map("voice_presets")
}

enum MusicMood {
  CINEMATIC
  HAPPY
  EMOTIONAL
  INSPIRATIONAL
  SUSPENSE
  CALM
  ADVENTURE
  CORPORATE
  CHILDRENS
}

model MusicTrack {
  id       String    @id @default(cuid())
  userId   String?
  name     String
  mood     MusicMood
  provider String    @default("mock")
  url      String?
  durationSeconds Int?
  isSystem Boolean   @default(true)

  createdAt DateTime @default(now())

  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ProjectMusic[]

  @@map("music_tracks")
}

model ProjectMusic {
  id           String @id @default(cuid())
  projectId    String
  musicTrackId String
  volume       Float  @default(0.5)
  fadeInMs     Int    @default(1000)
  fadeOutMs    Int    @default(2000)
  loop         Boolean @default(true)
  duckUnderVoice Boolean @default(true)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  musicTrack MusicTrack @relation(fields: [musicTrackId], references: [id], onDelete: Cascade)

  @@map("project_music")
}

// ---------------------------------------------------------------------------
// Generation / Render jobs
// ---------------------------------------------------------------------------

enum GenerationStage {
  SCRIPT_ANALYSIS
  STORYBOARD
  CHARACTER_EXTRACTION
  SCENE_PROMPT
  IMAGE
  ANIMATION
  VOICE
  MUSIC
  CAPTIONS
  COMPOSE
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model GenerationJob {
  id        String          @id @default(cuid())
  projectId String
  sceneId   String?
  stage     GenerationStage
  provider  String
  status    JobStatus       @default(QUEUED)
  metadata  Json?
  error     String?         @db.Text
  creditsCost Int           @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("generation_jobs")
}

enum RenderResolution {
  R_720P
  R_1080P
}

model RenderJob {
  id         String           @id @default(cuid())
  projectId  String
  resolution RenderResolution @default(R_1080P)
  aspectRatio AspectRatio
  status     JobStatus        @default(QUEUED)
  progress   Int              @default(0)
  stage      String?
  outputUrl  String?
  error      String?          @db.Text

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("render_jobs")
}
