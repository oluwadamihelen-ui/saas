// Prisma schema for the Hotel Management System (multi-tenant SaaS).
// See /ARCHITECTURE.md for the full system design this schema implements.
//
// Multi-tenancy: every hotel-scoped model carries a `hotelId` foreign key.
// Application code NEVER trusts a client-supplied hotelId -- every query is
// scoped server-side from the authenticated session (see lib/auth/hotel.ts),
// which is what actually guarantees Hotel A can never read Hotel B's data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// PLATFORM IDENTITY, ROLES & HOTELS
// =========================================================================

// Platform-wide role. SUPER_ADMIN is the only role with no hotel membership
// requirement (they manage the whole platform, not day-to-day operations of
// any one property). Every other role is granted per-hotel via HotelMember,
// so the same person can in principle work at more than one property (a
// hotel group) without a schema change.
enum RoleKey {
  SUPER_ADMIN
  HOTEL_OWNER
  HOTEL_MANAGER
  RECEPTIONIST
  ACCOUNTANT
  HOUSEKEEPING
  MAINTENANCE
  STAFF
}

model Permission {
  id            String           @id @default(uuid())
  key           String           @unique // e.g. "reservations.manage", "payments.record"
  description   String?
  category      String?
  roles         RolePermission[]
  userOverrides UserPermission[]
  createdAt     DateTime         @default(now())
}

model RolePermission {
  roleKey      RoleKey
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleKey, permissionId])
}

// Per-user permission overrides, scoped to a specific hotel membership so a
// Hotel Owner can fine-tune one receptionist's access without a new role.
model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  hotelId      String
  permissionId String
  granted      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel        Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, hotelId, permissionId])
  @@index([hotelId])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  name            String
  phone           String?
  image           String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)

  // Platform Super Admin flag. Deliberately separate from HotelMember roles
  // -- a Super Admin manages the platform (hotels, subscriptions, platform
  // settings) and is never implicitly a member of any one hotel's staff.
  isSuperAdmin Boolean @default(false)

  // Convenience pointer to the hotel shown by default after login, when the
  // user belongs to more than one (a hotel group). Not the source of truth
  // for access -- HotelMember rows are.
  primaryHotelId String?
  primaryHotel   Hotel?  @relation("PrimaryHotel", fields: [primaryHotelId], references: [id])

  memberships         HotelMember[]
  permissionOverrides UserPermission[]

  recordedPayments        Payment[]              @relation("PaymentReceivedBy")
  recordedCharges         AdditionalCharge[]     @relation("ChargeRecordedBy")
  recordedExpenses        Expense[]              @relation("ExpenseRecordedBy")
  createdReservations     Reservation[]          @relation("ReservationCreatedBy")
  checkedInReservations   Reservation[]          @relation("ReservationCheckedInBy")
  checkedOutReservations  Reservation[]          @relation("ReservationCheckedOutBy")
  cancelledReservations   Reservation[]          @relation("ReservationCancelledBy")
  transfersInitiated      RoomTransfer[]         @relation("TransferBy")
  housekeepingAssigned    HousekeepingTask[]     @relation("HousekeepingAssignedTo")
  housekeepingInspected   HousekeepingTask[]     @relation("HousekeepingInspectedBy")
  maintenanceReported     MaintenanceRequest[]   @relation("MaintenanceReportedBy")
  maintenanceAssigned     MaintenanceRequest[]   @relation("MaintenanceAssignedTo")
  roomStatusChanges       RoomStatusLog[]        @relation("RoomStatusChangedBy")
  notifications           Notification[]
  auditLogs               AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryHotelId])
}

enum HotelStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// A hotel (property). The tenant boundary for every operational model below.
model Hotel {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String?

  address String?
  city    String?
  state   String?
  country String?
  phone   String?
  email   String?
  website String?
  logoUrl String?

  currency      String @default("USD")
  timezone      String @default("UTC")
  checkInTime   String @default("14:00") // HH:mm, hotel-local
  checkOutTime  String @default("12:00")
  numberOfRooms Int    @default(0)

  taxRatePercent   Decimal @default(0) @db.Decimal(5, 2)
  invoicePrefix    String  @default("INV")
  reservationPrefix String @default("RES")

  status           HotelStatus      @default(TRIAL)
  subscriptionPlan SubscriptionPlan @default(STARTER)
  trialEndsAt      DateTime?

  // Support for hotel groups: a hotel may belong to a parent group, itself a
  // Hotel row with isGroupHQ=true and no operational data of its own -- lets
  // "Royal Hotel Group -> Lagos Branch / Abuja Branch" be modeled without a
  // second table today, and a real HotelGroup entity can be split out later
  // without touching every operational foreign key (they all point at the
  // branch, never the group).
  parentGroupId String?
  parentGroup   Hotel?  @relation("HotelGroup", fields: [parentGroupId], references: [id])
  branches      Hotel[] @relation("HotelGroup")
  isGroupHQ     Boolean @default(false)

  members             HotelMember[]
  primaryUsers         User[]                 @relation("PrimaryHotel")
  permissionOverrides  UserPermission[]
  roomTypes            RoomType[]
  rooms                Room[]
  guests               Guest[]
  reservations          Reservation[]
  payments              Payment[]
  additionalCharges     AdditionalCharge[]
  invoices              Invoice[]
  expenses              Expense[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceRequests   MaintenanceRequest[]
  roomTransfers         RoomTransfer[]
  roomStatusLogs        RoomStatusLog[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  settings              Setting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([parentGroupId])
}

// A user's membership at one hotel, carrying their role at that property.
// This is what "Hotel A cannot access Hotel B's data" is actually built on:
// every hotel-scoped request resolves the caller's HotelMember row for the
// hotel in question (never trusting a client-supplied hotelId alone) and
// denies access if none exists.
model HotelMember {
  id               String             @id @default(uuid())
  hotelId          String
  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             RoleKey
  department       StaffDepartment?
  employmentStatus EmploymentStatus   @default(ACTIVE)
  dateJoined       DateTime           @default(now())
  shift            StaffShift?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([hotelId, userId])
  @@index([userId])
  @@index([hotelId, role])
}

enum StaffDepartment {
  MANAGEMENT
  RECEPTION
  HOUSEKEEPING
  FINANCE
  MAINTENANCE
  SECURITY
  RESTAURANT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum StaffShift {
  MORNING
  AFTERNOON
  NIGHT
}

// =========================================================================
// ROOMS
// =========================================================================

model RoomType {
  id           String   @id @default(uuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  maxGuests    Int      @default(2)
  numBeds      Int      @default(1)
  bedType      String?
  amenities    String[]
  basePrice    Decimal  @db.Decimal(12, 2)
  images       String[]
  isActive     Boolean  @default(true)
  rooms        Room[]
  reservations Reservation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hotelId])
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTED
  MAINTENANCE
  OUT_OF_SERVICE
}

model Room {
  id          String     @id @default(uuid())
  hotelId     String
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId  String
  roomType    RoomType   @relation(fields: [roomTypeId], references: [id])
  roomNumber  String
  floor       String?
  price       Decimal?   @db.Decimal(12, 2) // overrides RoomType.basePrice when set
  status      RoomStatus @default(AVAILABLE)
  amenities   String[]
  description String?
  isActive    Boolean    @default(true)

  reservations        Reservation[]
  housekeepingTasks    HousekeepingTask[]
  maintenanceRequests  MaintenanceRequest[]
  statusLogs           RoomStatusLog[]
  transfersFrom         RoomTransfer[]        @relation("TransferFromRoom")
  transfersTo           RoomTransfer[]        @relation("TransferToRoom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status])
  @@index([roomTypeId])
}

// Append-only history of room status transitions, used for housekeeping /
// front-desk audit trails ("who marked 204 dirty, and when").
model RoomStatusLog {
  id            String     @id @default(uuid())
  hotelId       String
  hotel         Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromStatus    RoomStatus?
  toStatus      RoomStatus
  reason        String?
  changedById   String?
  changedBy     User?      @relation("RoomStatusChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([hotelId, roomId])
}

// =========================================================================
// GUESTS
// =========================================================================

model Guest {
  id                  String    @id @default(uuid())
  hotelId             String
  hotel               Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  firstName           String
  lastName             String
  phone                String?
  email                String?
  address              String?
  nationality          String?
  idType               String?
  idNumber             String?
  dateOfBirth          DateTime?
  emergencyContactName String?
  emergencyContactPhone String?
  preferences          String?
  notes                String?

  reservations      Reservation[]
  payments          Payment[]
  additionalCharges AdditionalCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, phone])
  @@index([hotelId, email])
  @@index([hotelId, lastName, firstName])
}

// =========================================================================
// RESERVATIONS
// =========================================================================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  ONLINE
  WALK_IN
  PHONE
  CORPORATE
  TRAVEL_AGENT
}

model Reservation {
  id          String   @id @default(uuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reference   String   @unique

  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id])

  checkInDate  DateTime // date only, stored at midnight UTC
  checkOutDate DateTime

  adults   Int @default(1)
  children Int @default(0)

  roomRate Decimal @db.Decimal(12, 2) // per-night rate locked in at booking time
  nights   Int
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  // totalAmount = subtotal - discount + tax + sum(AdditionalCharge.amount).
  // Recomputed by the service layer whenever a charge is added/removed or
  // the stay is extended/transferred -- never hand-edited.
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @default(0) @db.Decimal(12, 2)

  status ReservationStatus @default(PENDING)
  source ReservationSource @default(WALK_IN)

  notes String?

  createdById String?
  createdBy   User?   @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation("ReservationCheckedInBy", fields: [checkedInById], references: [id])

  checkedOutAt   DateTime?
  checkedOutById String?
  checkedOutBy   User?     @relation("ReservationCheckedOutBy", fields: [checkedOutById], references: [id])

  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?     @relation("ReservationCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?

  payments          Payment[]
  additionalCharges AdditionalCharge[]
  invoice           Invoice?
  roomTransfers     RoomTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, status])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([roomId])
  @@index([guestId])
}

// Historical record of a guest being moved from one room to another
// mid-stay. The reservation's roomId is updated to the new room, but this
// row preserves the original assignment permanently.
model RoomTransfer {
  id             String      @id @default(uuid())
  hotelId        String
  hotel          Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromRoomId     String
  fromRoom       Room        @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  toRoomId       String
  toRoom         Room        @relation("TransferToRoom", fields: [toRoomId], references: [id])
  reason         String?
  transferredById String?
  transferredBy  User?       @relation("TransferBy", fields: [transferredById], references: [id])
  transferredAt  DateTime    @default(now())

  @@index([hotelId])
  @@index([reservationId])
}

// =========================================================================
// PAYMENTS, CHARGES & INVOICES
// =========================================================================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  POS
  ONLINE_PAYMENT
  PAYMENT_LINK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reference     String        @unique
  guestId       String
  guest         Guest         @relation(fields: [guestId], references: [id])
  reservationId String?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  paymentDate   DateTime      @default(now())
  receivedById  String?
  receivedBy    User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([hotelId])
  @@index([reservationId])
  @@index([guestId])
}

enum ChargeType {
  LAUNDRY
  ROOM_SERVICE
  RESTAURANT
  BAR
  MINI_BAR
  EXTRA_BED
  AIRPORT_PICKUP
  LATE_CHECKOUT
  OTHER
}

model AdditionalCharge {
  id            String      @id @default(uuid())
  hotelId       String
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId       String
  guest         Guest       @relation(fields: [guestId], references: [id])
  type          ChargeType
  description   String?
  amount        Decimal     @db.Decimal(12, 2)
  date          DateTime    @default(now())
  recordedById  String?
  recordedBy    User?       @relation("ChargeRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime    @default(now())

  @@index([hotelId])
  @@index([reservationId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

// Snapshot of a completed guest folio at (or after) checkout. Line items are
// stored as JSON since they're a point-in-time copy of room charges +
// additional charges -- never recomputed from live data once issued, so a
// later charge/payment edit never silently rewrites a past invoice.
model Invoice {
  id            String        @id @default(uuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  guestId       String
  status        InvoiceStatus @default(ISSUED)
  lineItems     Json // [{ description, quantity, unitPrice, total }]
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([hotelId])
}

// =========================================================================
// EXPENSES
// =========================================================================

enum ExpenseCategory {
  ELECTRICITY
  WATER
  STAFF_SALARY
  FOOD
  MAINTENANCE
  SUPPLIES
  INTERNET
  MARKETING
  OTHER
}

model Expense {
  id           String          @id @default(uuid())
  hotelId      String
  hotel        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reference    String          @unique
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  date         DateTime        @default(now())
  description  String?
  vendor       String?
  recordedById String?
  recordedBy   User?           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  receiptUrl   String?
  createdAt    DateTime        @default(now())

  @@index([hotelId, date])
  @@index([hotelId, category])
}

// =========================================================================
// HOUSEKEEPING & MAINTENANCE
// =========================================================================

enum HousekeepingTaskType {
  CLEAN_ROOM
  CHANGE_BEDSHEETS
  REPLACE_TOWELS
  RESTOCK_AMENITIES
  DEEP_CLEANING
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
}

model HousekeepingTask {
  id             String                  @id @default(uuid())
  hotelId        String
  hotel          Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room                    @relation(fields: [roomId], references: [id])
  taskType       HousekeepingTaskType    @default(CLEAN_ROOM)
  status         HousekeepingTaskStatus  @default(PENDING)
  assignedToId   String?
  assignedTo     User?                   @relation("HousekeepingAssignedTo", fields: [assignedToId], references: [id])
  notes          String?
  startedAt      DateTime?
  completedAt    DateTime?
  inspectedAt    DateTime?
  inspectedById  String?
  inspectedBy    User?                   @relation("HousekeepingInspectedBy", fields: [inspectedById], references: [id])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([hotelId, status])
  @@index([roomId])
}

enum MaintenanceIssueType {
  AIR_CONDITIONING
  PLUMBING
  ELECTRICAL
  FURNITURE
  TELEVISION
  INTERNET
  OTHER
}

enum MaintenanceStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceRequest {
  id           String                @id @default(uuid())
  hotelId      String
  hotel        Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?                 @relation(fields: [roomId], references: [id])
  issueType    MaintenanceIssueType
  description  String
  priority     MaintenancePriority   @default(MEDIUM)
  status       MaintenanceStatus     @default(REPORTED)
  reportedById String?
  reportedBy   User?                 @relation("MaintenanceReportedBy", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   User?                 @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([hotelId, status])
  @@index([roomId])
}

// =========================================================================
// NOTIFICATIONS, AUDIT LOG & SETTINGS
// =========================================================================

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  WHATSAPP
}

model Notification {
  id        String              @id @default(uuid())
  hotelId   String?
  hotel     Hotel?              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      String
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  data      Json?
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([hotelId])
}

model AuditLog {
  id           String   @id @default(uuid())
  hotelId      String?
  hotel        Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([hotelId])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// Per-hotel configurable settings not already modeled as a Hotel column
// (e.g. notification thresholds, invoice footer text). Keyed so new settings
// don't require a migration.
model Setting {
  id        String   @id @default(uuid())
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([hotelId, key])
}
