# Copy to .env.production and fill in for a self-hosted (docker compose)
# install. This is separate from .env.example: that one is for local dev
# (`npm run dev`); this one is loaded into the app container by
# docker-compose.yml's "env_file:" — DATABASE_URL/DIRECT_URL are NOT here,
# docker-compose.yml sets those itself from the root .env file's
# POSTGRES_PASSWORD (see the "Database password" section of the install
# guide for why).
#
# Every value below must be freshly generated for THIS install — never
# copy a secret from schoolum.io's own Vercel environment variables into
# here. Reusing a secret across two independent deployments is the one
# mistake that actually links them together.

# --- Auth (Auth.js) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The client's real domain, with https:// — must match exactly what's in
# the Caddyfile.
NEXTAUTH_URL="https://app.theirschool.com"

# --- Public app URL -------------------------------------------------------
APP_URL="https://app.theirschool.com"

# --- Payments -------------------------------------------------------------
# Encrypts each school's own connected payment-gateway secret keys at rest.
# Generate with: openssl rand -base64 32 — must be DIFFERENT from AUTH_SECRET.
PAYMENT_KEYS_SECRET=""

# --- Platform billing ------------------------------------------------------
# This is how SCHOOLUM charges SCHOOLS a subscription on the multi-tenant
# schoolum.io SaaS. A single-tenant self-hosted install for one client has
# no subscription to charge — leave both blank.
PLATFORM_PAYSTACK_PUBLIC_KEY=""
PLATFORM_PAYSTACK_SECRET_KEY=""

# --- AI assistant (optional) -----------------------------------------------
# Leave both blank to ship without it — the feature shows an honest "not
# configured" message instead of the app breaking.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Live classes (optional) ------------------------------------------------
# Leave blank to ship without live video classes — "Schedule Live Class"
# still works, "Start Class" shows an honest "not configured" message.
# Get these from https://cloud.livekit.io (fastest) or a self-hosted
# LiveKit server.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- File storage (needed for lecture uploads, report card logos, etc.) ----
# Vercel Blob works fine from outside Vercel hosting — it's just an API
# token. Create one from any Vercel account's Storage tab (a free account
# works). Leave blank and uploads fail with a clear "storage is not
# configured" message rather than a crash.
BLOB_READ_WRITE_TOKEN=""

# --- Live class recording (optional) ----------------------------------------
RECORDING_S3_BUCKET=""
RECORDING_S3_REGION=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET_KEY=""
