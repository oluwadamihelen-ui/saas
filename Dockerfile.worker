# syntax=docker/dockerfile:1
FROM node:20-slim AS worker-base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo

# Install and build happen in one continuous stage — deliberately not split
# into a separate deps stage with a cross-stage `COPY --from=deps` of
# node_modules. Two different packages (prisma, then next) intermittently
# failed to resolve their own just-installed files immediately after that
# kind of cross-stage copy on at least one real Docker Desktop/Windows/WSL2
# setup, and in one case the copied node_modules didn't even match the
# locally-verified peer-dependency resolution. Sacrifices some layer-caching
# (any source change now reinstalls, not just a package.json change) for
# reliability — a slower build beats an intermittently broken one.
FROM worker-base AS worker-build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cinerra/worker build

FROM worker-base AS worker-runner
ENV NODE_ENV=production
WORKDIR /repo
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*
COPY --from=worker-build /repo /repo
CMD ["pnpm", "--filter", "@cinerra/worker", "start"]
