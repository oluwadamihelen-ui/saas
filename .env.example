# Copy this file to .env and fill in values for your environment.

# --- Database ---------------------------------------------------------
# Must support the `btree_gist` extension (used by the double-booking
# exclusion constraint on Reservation). Standard on self-hosted Postgres
# (postgresql-contrib) and on most managed providers (Neon, Supabase, RDS,
# Cloud SQL); confirm your provider allows `CREATE EXTENSION btree_gist`
# before running migrations in production.
DATABASE_URL="postgresql://user:password@localhost:5432/otelum?schema=public"

# --- Auth (Auth.js) -----------------------------------------------------
# Generate with: openssl rand -base64 32 -- use a different value per
# environment, never commit a real one, and never reuse the dev placeholder
# in production.
AUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Background jobs (BullMQ) --------------------------------------------
# Used for the daily operations sweep (arrival/departure reminders, stale
# outstanding-balance alerts, auto no-show flagging). See scripts/worker.ts.
REDIS_URL="redis://localhost:6379"

# --- Public app URL ---------------------------------------------------
APP_URL="http://localhost:3000"

# --- Production Super Admin bootstrap ------------------------------------
# Only read by `npm run db:seed` when NODE_ENV=production, and only to
# create this one account -- in production the seed script never creates
# demo hotels, demo staff, or the dev Super Admin (admin@otelum.io /
# Passw0rd!). Leave unset to skip creating a Super Admin at seed time.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# --- Credential encryption ------------------------------------------------
# Encrypts hotel-supplied payment gateway secret keys (Paystack/Flutterwave/
# Kora Pay) at rest -- see lib/security/encryption.ts. Generate with:
# openssl rand -base64 32 -- a different value per environment, and losing
# it means every hotel has to re-enter their payment gateway keys.
CREDENTIALS_ENCRYPTION_KEY=""

# --- Transactional email (Brevo) ------------------------------------------
# Powers every email notification (reservation created, checked in/out,
# payment received, cancellations, maintenance reports, staff welcome
# emails, password-change notices). Get an API key from
# https://app.brevo.com/settings/keys/api. Leave BREVO_API_KEY unset to
# disable email sending entirely -- in-app notifications keep working
# either way, this only gates the email channel.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="hello@otelum.io"
BREVO_SENDER_NAME="Otelum"
