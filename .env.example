# Copy this file to .env and fill in values for your environment.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_saas?schema=public"

# --- Auth (Auth.js) -----------------------------------------------------
AUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Background jobs (BullMQ) --------------------------------------------
# Used for the daily operations sweep (arrival/departure reminders, stale
# outstanding-balance alerts, auto no-show flagging). See scripts/worker.ts.
REDIS_URL="redis://localhost:6379"

# --- Public app URL ---------------------------------------------------
APP_URL="http://localhost:3000"
