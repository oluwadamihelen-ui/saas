# ---------------------------------------------------------------------------
# MAMA Business OS — environment variables
# Copy this file to `.env` for local development and fill in real values.
# Never commit `.env` — secrets belong here only, never in code.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (see README for Neon/Supabase/Railway setup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mama_business?schema=public"

# Auth.js (NextAuth) — generate with `openssl rand -base64 32`
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to disable "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Businesses can also connect their own keys from Settings → Payments;
# these act as a platform-level fallback (used by the demo business).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
# Per-business credentials are normally entered in-app during onboarding;
# these act as a fallback for local development/testing.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="choose-a-verify-token"
WHATSAPP_APP_SECRET=""

# Mama AI provider
# AI_PROVIDER="mock" runs Mama AI without any external API key, using
# deterministic tool selection so it still only ever answers from real
# business data (never invents numbers) — good for local dev/demo.
# Set AI_PROVIDER="anthropic" + AI_API_KEY to use a real model.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Public app URL (used to build webhook/callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
