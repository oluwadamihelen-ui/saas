# Copy this file to .env and fill in values for your environment.
# Everything works with mock providers out of the box — no real payment,
# domain, or hosting credentials are required for local development.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/saas_platform?schema=public"

# --- Auth (Auth.js) -----------------------------------------------------
AUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Background jobs (BullMQ) --------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Secrets encryption ---------------------------------------------------
# Base64-encoded 32-byte key used to encrypt provider/deployment credentials
# at rest (AES-256-GCM). Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-real-base64-32-byte-key"

# --- Public app URL ---------------------------------------------------
APP_URL="http://localhost:3000"

# --- Provider selection -------------------------------------------------
# Each defaults to "mock" so the platform is fully testable without live
# credentials. Switch to a real adapter key to activate it.
PAYMENT_PROVIDER="mock"        # mock | paystack | korapay | nowpayments
DOMAIN_PROVIDER="mock"         # mock | namecheap
HOSTING_PROVIDER="mock"
DNS_PROVIDER="mock"
DEPLOYMENT_PROVIDER="mock"
EMAIL_PROVIDER="mock"          # mock | resend
STORAGE_PROVIDER="local"

# --- Paystack (only needed if PAYMENT_PROVIDER=paystack) -----------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# --- KoraPay (only needed if PAYMENT_PROVIDER=korapay) --------------------
KORAPAY_SECRET_KEY=""

# --- NOWPayments (only needed if PAYMENT_PROVIDER=nowpayments) ------------
# API key from Personal Account > Payment Settings. IPN secret is a
# separate key generated in the same section, used only to verify webhook
# signatures -- never sent on outbound requests.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# --- Resend (only needed if EMAIL_PROVIDER=resend) ------------------------
RESEND_API_KEY=""

# --- Namecheap (only needed if DOMAIN_PROVIDER=namecheap) ------------------
# ClientIp must be an IP address whitelisted in your Namecheap account
# (Profile > Tools > API Access > Manage IP Whitelist) -- requests from any
# other IP are rejected even with a correct key. Sandbox uses a separate
# sandbox.namecheap.com account with its own credentials; set
# NAMECHEAP_SANDBOX="false" only once you're using real production
# credentials and are ready to register real domains.
NAMECHEAP_API_USER=""
NAMECHEAP_API_KEY=""
NAMECHEAP_USERNAME=""
NAMECHEAP_CLIENT_IP=""
NAMECHEAP_SANDBOX="true"

# --- Rate limiting --------------------------------------------------------
# Uses the same Redis instance as REDIS_URL above; no extra config needed.

# --- Observability (optional) ----------------------------------------------
# If set, uncaught server errors (see instrumentation.ts) are also POSTed
# here as JSON, in addition to the structured application log. Point this at
# any webhook relay -- Sentry, a Slack incoming webhook, your own endpoint.
ERROR_WEBHOOK_URL=""
