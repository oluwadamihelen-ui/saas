# Copy this file to .env and fill in real values.
# Only variables the application actually reads are listed here (spec §71).

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Database (required) ---
DATABASE_URL=postgresql://cinerra:cinerra@localhost:5432/cinerra

# --- Queue (required) ---
REDIS_URL=redis://localhost:6379

# --- Object storage — S3-compatible: AWS S3, Cloudflare R2, or local MinIO (required) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=cinerra-media
STORAGE_ACCESS_KEY_ID=cinerra
STORAGE_SECRET_ACCESS_KEY=cinerra-secret
STORAGE_FORCE_PATH_STYLE=true
# Set this to your CDN/public bucket URL in production; omit to use signed URLs.
# STORAGE_PUBLIC_BASE_URL=https://media.yourapp.com

# --- Auth (required) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Optional Google sign-in:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Billing (optional — checkout/portal return "not configured" until set) ---
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI providers (all optional — each capability honestly reports "not configured" until its key is set) ---
# Language model (Story Architect, Screenwriter, Character/Location Designer agents)
# ANTHROPIC_API_KEY=sk-ant-...
# Image generation / analysis (reference images, storyboard frames)
# OPENAI_API_KEY=sk-...
# Video generation (image-to-video / video-to-video shot generation)
# RUNWAY_API_KEY=...
# Voice generation (dialogue synthesis)
# ELEVENLABS_API_KEY=...
