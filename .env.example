# Database (docker-compose postgres service)
DATABASE_URL="postgresql://saas:saas_dev_password@localhost:5432/saas?schema=public"

# Redis (docker-compose redis service) — used by the BullMQ job queue
REDIS_URL="redis://localhost:6379"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Public base URL of the running web app — the render worker needs this to
# fetch scene images/audio (served from public/uploads) over HTTP while
# compositing a video in a headless browser.
APP_URL="http://localhost:3000"

# Absolute path to a Chrome/Chromium binary for Remotion's headless renderer.
# Leave unset to let Remotion download/manage its own; set this if you
# already have a Chromium install (e.g. one Playwright manages).
REMOTION_BROWSER_EXECUTABLE=""

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, ...)
# Leave unset in development to use the local-disk storage provider.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# AI providers — leave unset to run entirely on mock providers.
AI_PROVIDER="mock"          # mock | openai | anthropic
IMAGE_PROVIDER="mock"       # mock | ...
VIDEO_PROVIDER="mock"       # mock | ...
VOICE_PROVIDER="mock"       # mock | ...
MUSIC_PROVIDER="mock"       # mock | ...

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Stripe (Phase E)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
