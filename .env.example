# Copy this file to .env and fill in values for your environment.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/schoolum?schema=public"

# --- Auth (Auth.js) -----------------------------------------------------
AUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3001"

# --- Public app URL ---------------------------------------------------
APP_URL="http://localhost:3001"

# --- Payments -----------------------------------------------------------
# Each school connects its own Paystack/Flutterwave/Korapay account from
# Dashboard > Settings — no platform-wide gateway credentials here. A
# school that hasn't connected one gets a simulated/demo "Pay online"
# instead, so the invoice -> pay -> receipt flow always works.
#
# PAYMENT_KEYS_SECRET encrypts every school's stored gateway secret keys
# at rest (AES-256-GCM) — set a real random value in production. Falls
# back to AUTH_SECRET if unset, so local dev needs no extra setup.
PAYMENT_KEYS_SECRET="generate-a-different-random-32-byte-string"

# --- Platform billing (schools paying Schoolum) --------------------------
# Schoolum's OWN Paystack merchant account, used to charge SCHOOLS for
# their subscription (Starter/Professional/Premium/Enterprise) — a
# completely different thing from the per-school gateway keys above, which
# schools use to collect fees from THEIR parents. Leave unset in dev/demo
# and platform billing uses a simulated "Pay now" -> confirm flow instead,
# same as the parent-facing payments do with no gateway connected.
PLATFORM_PAYSTACK_PUBLIC_KEY=""
PLATFORM_PAYSTACK_SECRET_KEY=""
# Configure this URL as the webhook endpoint in the Paystack dashboard for
# Schoolum's own account: https://<your-domain>/api/webhooks/platform-paystack

# --- AI assistant (Phase 5) ---------------------------------------------
# Set ONE of these to turn on the AI assistant (/dashboard/assistant) — with
# neither set, the feature shows an honest "not configured" message instead
# of faking a response. If both are set, AI_PROVIDER picks which one to use
# (defaults to openai if unset).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# AI_PROVIDER="openai"
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_MODEL="claude-sonnet-5"
# CBT AI features (question generation, exam insights, revision plans, grading
# suggestions — Phase 7) reuse these same variables. No additional config
# needed; without a key they degrade gracefully instead of faking output.

# --- Online Learning: native live virtual classroom (Phase 8) -----------
# The live classroom is built on LiveKit (open-source, SFU-based — not a
# peer-to-peer mesh, so it scales past a handful of participants) fully
# embedded inside Schoolum's own UI at /classroom/[liveClassId] — nobody
# ever leaves the app, creates a LiveKit account, or sees LiveKit's own
# interface. LIVEKIT_URL can point at either LiveKit Cloud (fastest to set
# up: https://cloud.livekit.io) or a self-hosted LiveKit server your own
# infrastructure team deploys (LiveKit is open source) — this app talks to
# either one identically. Leave unset and "Schedule Live Class" still
# works, but "Start Class" shows an honest "not configured" message
# instead of a fake session, the same way the AI assistant degrades above.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Lecture videos/documents and live class recordings are stored in Vercel
# Blob (private access — every file is served back through this app's own
# authenticated route, never a bare public URL). Get a token from your
# Vercel project's Storage tab. Without it, uploading a lecture resource
# fails with a clear "storage is not configured" message.
BLOB_READ_WRITE_TOKEN=""

# Optional: live class recording (brief: "design the architecture to
# optionally support class recording"). LiveKit records via Egress, which
# writes its output to an S3-compatible bucket — separate from the Vercel
# Blob store above. Leave unset and the "Start recording" control simply
# doesn't appear, rather than promising a recording that can't be stored.
RECORDING_S3_BUCKET=""
RECORDING_S3_REGION=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET_KEY=""
