# syntax=docker/dockerfile:1
FROM node:20-slim AS web-base
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo

FROM web-base AS web-deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/billing/package.json packages/billing/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/email/package.json packages/email/package.json
COPY packages/media/package.json packages/media/package.json
COPY packages/queue/package.json packages/queue/package.json
COPY packages/storage/package.json packages/storage/package.json
# The root postinstall script (`prisma generate`) fires during the install
# below, so the schema it needs has to be here already — package.json
# manifests alone (copied above, for Docker layer caching) aren't enough.
COPY packages/database/prisma packages/database/prisma
RUN pnpm install --frozen-lockfile

FROM web-base AS web-build
COPY --from=web-deps /repo /repo
COPY . .
# No explicit `prisma generate` here — web-deps's own `pnpm install` already
# ran it (via the root postinstall script, now that web-deps also has the
# schema it needs) and the generated client came along in the COPY above.
# Running it again was redundant and, on some Docker Desktop/WSL2 setups,
# intermittently failed to find its own just-installed prisma package.
# `next build` statically analyzes every route, which imports packages/config's
# env schema at module load time — it needs *some* value for each required
# var to pass validation, even though nothing actually connects to Postgres/
# Redis/S3 during a production build. These never reach the runtime image:
# web-runner starts fresh FROM web-base and only copies files (not ENV) from
# this stage, so the real values docker-compose.yml supplies at `up` time are
# what the container actually runs with. Matches .github/workflows/ci.yml's
# own build step, which solves the identical problem the identical way.
ENV NODE_ENV=production \
    DATABASE_URL=postgresql://cinerra:cinerra@localhost:5432/cinerra \
    REDIS_URL=redis://localhost:6379 \
    STORAGE_ENDPOINT=http://localhost:9000 \
    STORAGE_REGION=auto \
    STORAGE_BUCKET=cinerra-media \
    STORAGE_ACCESS_KEY_ID=cinerra \
    STORAGE_SECRET_ACCESS_KEY=cinerra-secret \
    STORAGE_FORCE_PATH_STYLE=true \
    AUTH_SECRET=docker-build-only-secret-not-for-real-use-0000000000 \
    APP_BASE_URL=http://localhost:3000
RUN pnpm --filter @cinerra/web build

FROM web-base AS web-runner
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=web-build /repo /repo
EXPOSE 3000
CMD ["pnpm", "--filter", "@cinerra/web", "start"]
