# Copy this file to .env and fill in values for your environment.
# Use a DIFFERENT database from apps/marketplace — these are two separate
# products with no shared data.

# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/klaso_school?schema=public"

# --- Auth (Auth.js) -----------------------------------------------------
AUTH_SECRET="generate-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3001"

# --- Public app URL ---------------------------------------------------
APP_URL="http://localhost:3001"

# --- Payments -----------------------------------------------------------
# Each school connects its own Paystack/Flutterwave/Korapay account from
# Dashboard > Settings — no platform-wide gateway credentials here. A
# school that hasn't connected one gets a simulated/demo "Pay online"
# instead, so the invoice -> pay -> receipt flow always works.
#
# PAYMENT_KEYS_SECRET encrypts every school's stored gateway secret keys
# at rest (AES-256-GCM) — set a real random value in production. Falls
# back to AUTH_SECRET if unset, so local dev needs no extra setup.
PAYMENT_KEYS_SECRET="generate-a-different-random-32-byte-string"

# --- AI assistant (Phase 5) ---------------------------------------------
# Set ONE of these to turn on the AI assistant (/dashboard/assistant) — with
# neither set, the feature shows an honest "not configured" message instead
# of faking a response. If both are set, AI_PROVIDER picks which one to use
# (defaults to openai if unset).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# AI_PROVIDER="openai"
# OPENAI_MODEL="gpt-4o-mini"
# ANTHROPIC_MODEL="claude-sonnet-5"
