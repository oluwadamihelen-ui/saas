generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform / tenancy
// ---------------------------------------------------------------------------

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// The tenant root. Every tenant-owned table below carries a schoolId and
/// must be queried through the scoped repository helpers in src/lib/tenant.ts
/// — never a bare `prisma.<model>.findMany()` for a tenant-owned model.
model School {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status SchoolStatus @default(TRIAL)

  logoUrl String?
  email   String?
  phone   String?
  website String?

  addressLine String?
  city        String?
  state       String?
  country     String  @default("Nigeria")

  currency String @default("NGN")
  timezone String @default("Africa/Lagos")

  /// Expenses at or above this amount (in the school's currency minor
  /// units) require SCHOOL_OWNER/SCHOOL_ADMIN approval before being marked
  /// APPROVED — configurable per school (brief: "Expenses above ₦500,000
  /// require owner approval").
  expenseApprovalThresholdMinor Int @default(50000000)

  /// Shown on the public pay page for the bank-transfer option. Null/empty
  /// simply hides that option rather than showing placeholder text.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?

  // Onboarding wizard progress (brief section 4). Nullable timestamps double
  // as both a "is this step done" flag and a record of when it happened.
  accountCreatedAt         DateTime  @default(now())
  schoolInfoCompletedAt    DateTime?
  academicStructureSetupAt DateTime?
  staffInvitedAt           DateTime?
  onboardingCompletedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses             Campus[]
  users                User[]
  roles                Role[]
  invites              StaffInvite[]
  academicSessions     AcademicSession[]
  terms                Term[]
  departments          Department[]
  classGroups          ClassGroup[]
  classArms            ClassArm[]
  subjects             Subject[]
  students             Student[]
  guardians            Guardian[]
  auditLogs            AuditLog[]
  teacherAssignments   TeacherAssignment[]
  attendanceRecords    AttendanceRecord[]
  timetableSlots       TimetableSlot[]
  assignments          Assignment[]
  gradeBands           GradeBand[]
  assessmentComponents AssessmentComponent[]
  scores               Score[]
  reportCards          ReportCard[]
  feeCategories        FeeCategory[]
  feeStructures        FeeStructure[]
  invoices             Invoice[]
  payments             Payment[]
  vendors              Vendor[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]

  @@index([status])
}

model Campus {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  isMain   Boolean @default(false)

  addressLine String?
  city        String?
  state       String?

  createdAt DateTime @default(now())

  students Student[]

  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Identity, roles & permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// schoolId is null only for platform Super Admins. Every other user belongs
/// to exactly one school in Phase 1 — a staff member working at two schools
/// is out of scope until multi-membership is needed.
model User {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role    @relation(fields: [roleId], references: [id])
  campusId String?

  email        String     @unique
  passwordHash String
  name         String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs             AuditLog[]
  classArmsLed          ClassArm[]             @relation("ClassArmTeacher")
  invitesSent           StaffInvite[]          @relation("InviteSentBy")
  teacherAssignments    TeacherAssignment[]    @relation("TeacherAssignments")
  attendanceMarked      AttendanceRecord[]     @relation("AttendanceMarkedBy")
  teacherTimetableSlots TimetableSlot[]        @relation("TeacherTimetableSlots")
  assignmentsCreated    Assignment[]           @relation("AssignmentTeacher")
  submissionsGraded     AssignmentSubmission[] @relation("SubmissionGradedBy")
  scoresEntered         Score[]                @relation("ScoreEnteredBy")
  reportCardsApproved   ReportCard[]           @relation("ReportCardApprovedBy")
  paymentsRecorded      Payment[]              @relation("PaymentRecordedBy")
  expensesCreated       Expense[]              @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]              @relation("ExpenseApprovedBy")

  @@index([schoolId])
}

/// Roles are tenant-scoped (schoolId set) except the single platform-level
/// SUPER_ADMIN role (schoolId null), so a school can customize its own
/// role -> permission matrix without touching any other school's roles.
/// System roles (isSystem) are seeded for every school and can't be deleted.
model Role {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  key      String
  name     String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  users           User[]
  rolePermissions RolePermission[]
  staffInvites    StaffInvite[]

  @@unique([schoolId, key])
  @@index([schoolId])
}

/// Global catalog of module.action permission strings (e.g. "students.view").
/// Not tenant-scoped — the catalog itself is fixed; which roles have which
/// permission is the tenant-editable part, via RolePermission.
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  module      String
  action      String
  description String

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model StaffInvite {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  email       String
  roleId      String
  role        Role         @relation(fields: [roleId], references: [id])
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String
  invitedBy   User         @relation("InviteSentBy", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([schoolId, email, status])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model AcademicSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())

  terms Term[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id                String          @id @default(cuid())
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())

  attendanceRecords AttendanceRecord[]
  assignments       Assignment[]
  scores            Score[]
  reportCards       ReportCard[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]

  @@unique([academicSessionId, name])
  @@index([schoolId])
}

model Department {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  classGroups ClassGroup[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A grade level, e.g. "JSS1", "SS2" — the brief calls this a "Class".
model ClassGroup {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  name  String
  order Int    @default(0)

  createdAt DateTime @default(now())

  arms          ClassArm[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A specific stream within a class group, e.g. "JSS1 Blue" — this is what
/// students are actually enrolled into.
model ClassArm {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  name           String
  capacity       Int?
  classTeacherId String?
  classTeacher   User?   @relation("ClassArmTeacher", fields: [classTeacherId], references: [id])

  createdAt DateTime @default(now())

  students           Student[]
  teacherAssignments TeacherAssignment[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  assignments        Assignment[]

  @@unique([classGroupId, name])
  @@index([schoolId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String

  createdAt DateTime @default(now())

  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  assignments        Assignment[]
  scores             Score[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Students & guardians
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

model Student {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  admissionNumber String

  firstName   String
  lastName    String
  otherNames  String?
  photoUrl    String?
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?
  nationality String?   @default("Nigeria")

  addressLine String?
  city        String?
  state       String?

  medicalNotes     String?
  allergies        String?
  emergencyContact String?

  classArmId String?
  classArm   ClassArm? @relation(fields: [classArmId], references: [id])

  status        StudentStatus @default(ACTIVE)
  admissionDate DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians         StudentGuardian[]
  attendanceRecords AttendanceRecord[]
  submissions       AssignmentSubmission[]
  scores            Score[]
  reportCards       ReportCard[]
  invoices          Invoice[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, classArmId])
  @@index([schoolId, status])
}

model Guardian {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  email       String?
  addressLine String?
  occupation  String?

  createdAt DateTime @default(now())

  students StudentGuardian[]

  @@index([schoolId])
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model StudentGuardian {
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)

  @@id([studentId, guardianId])
}

// ---------------------------------------------------------------------------
// Academics: teaching assignments, attendance, timetable, assignments,
// assessments & results (Phase 2)
// ---------------------------------------------------------------------------

/// Which teacher teaches which subject to which class arm. Foundation for
/// scoping attendance/assignment/score-entry actions to "your own class"
/// later, without another schema change.
model TeacherAssignment {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, classArmId])
  @@index([schoolId])
  @@index([schoolId, teacherId])
  @@index([schoolId, classArmId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Extensible on purpose (brief section 8: "start manual, leave room for
/// QR/biometric"); only MANUAL is actually implemented.
enum AttendanceMethod {
  MANUAL
  QR
  BIOMETRIC
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  termId     String
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  date       DateTime
  status     AttendanceStatus
  method     AttendanceMethod @default(MANUAL)
  note       String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([schoolId, classArmId, date])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

/// One recurring weekly period. startTime/endTime are "HH:mm" 24h strings —
/// simpler than DateTime for a slot that repeats every week with no fixed
/// calendar date, and easy to render/sort/compare as plain strings.
model TimetableSlot {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation("TeacherTimetableSlots", fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, classArmId, dayOfWeek])
  @@index([schoolId, teacherId, dayOfWeek])
}

model Assignment {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classArmId String
  classArm   ClassArm @relation(fields: [classArmId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    User     @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  termId     String
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([schoolId, classArmId])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

/// One row per student per assignment, created up front for the whole
/// class so a teacher gets a gradebook immediately — there's no student
/// portal yet (Phase 4) for self-service submission, so a teacher records
/// what was handed in and grades it from here.
model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status     SubmissionStatus @default(PENDING)
  score      Int?
  feedback   String?
  gradedAt   DateTime?
  gradedById String?
  gradedBy   User?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

/// Per-school configurable grading scale (brief: "schools must be able to
/// configure grading systems"), e.g. A=70-100 "Excellent".
model GradeBand {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  grade    String
  minScore Int
  maxScore Int
  remark   String
  order    Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([schoolId, grade])
  @@index([schoolId])
}

/// Per-school configurable score components for a subject's total, e.g.
/// "1st CA" (max 20), "2nd CA" (max 20), "Exam" (max 60).
model AssessmentComponent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name     String
  maxScore Int
  order    Int    @default(0)

  createdAt DateTime @default(now())

  scores Score[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Score {
  id          String              @id @default(cuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId      String
  term        Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  componentId String
  component   AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  value       Int
  enteredById String
  enteredBy   User   @relation("ScoreEnteredBy", fields: [enteredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, componentId])
  @@index([schoolId])
  @@index([schoolId, studentId, termId])
  @@index([schoolId, subjectId, termId])
}

enum ReportCardStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

/// A per-student per-term workflow record (brief section 45's RESULTS
/// workflow: score entry -> validation -> approval -> report card -> parent
/// notification). Totals/grades/positions are computed from Score at read
/// time rather than duplicated here — this row only tracks the human
/// approval/publish gate and optional comments.
model ReportCard {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  status           ReportCardStatus @default(DRAFT)
  teacherComment   String?
  principalComment String?

  approvedById String?
  approvedBy   User?     @relation("ReportCardApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Finance: fee structures, invoices, payments, expenses (Phase 3)
// ---------------------------------------------------------------------------

/// All money in this section is stored as an integer in the school's
/// currency's minor units (e.g. kobo for NGN) — never a float — and
/// formatted for display with formatMoney() in src/lib/money.ts.

model FeeCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  createdAt DateTime @default(now())

  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// classGroupId null means "applies to every class" (e.g. a school-wide
/// book levy); set means it only applies to that grade level.
model FeeStructure {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId   String
  category     FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  classGroupId String?
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  termId       String
  term         Term        @relation(fields: [termId], references: [id], onDelete: Cascade)

  name        String
  amountMinor Int

  createdAt DateTime @default(now())

  invoiceItems InvoiceItem[]

  @@index([schoolId])
  @@index([schoolId, termId])
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// One invoice per student per term, generated from the FeeStructure rows
/// applicable to that student's class (see generateInvoicesForClass in
/// src/lib/services/finance.ts). status is derived from confirmed Payment
/// totals against totalMinor, recomputed on every payment rather than
/// trusted as independently-settable state. payToken lets an unauthenticated
/// parent open /pay/[token] to view and pay it — there's no parent login
/// yet (Phase 4), so this is how "online payments" and "bank transfer" are
/// reachable at all in this phase.
model Invoice {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  invoiceNumber  String        @unique
  status         InvoiceStatus @default(ISSUED)
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  discountReason String?
  totalMinor     Int
  dueDate        DateTime
  payToken       String        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([schoolId, status])
}

model InvoiceItem {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])

  description String
  amountMinor Int

  @@index([invoiceId])
}

enum PaymentMethod {
  MANUAL
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Payment {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountMinor  Int
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  reference    String        @unique
  paidAt       DateTime?
  recordedById String?
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([invoiceId])
}

model Vendor {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  contactInfo String?

  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ExpenseCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String

  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// status starts PENDING only when the amount is at/over the school's
/// expenseApprovalThresholdMinor; smaller expenses are auto-approved at
/// creation (see recordExpense in src/lib/services/finance.ts) — the
/// brief's threshold rule, not a rubber stamp on everything.
model Expense {
  id         String          @id @default(cuid())
  schoolId   String
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id])

  description  String
  amountMinor  Int
  status       ExpenseStatus @default(PENDING)
  incurredAt   DateTime
  createdById  String
  createdBy    User          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?         @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, status])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  action        String
  resourceType  String
  resourceId    String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([resourceType, resourceId])
}
